# ─────────────────────────────────────────────────────────
# DataTrust — Environment Configuration Template
# ─────────────────────────────────────────────────────────
# COPY this file to .env and fill in your real values.
# NEVER commit the actual .env file to Git (.gitignore already excludes it).
# ─────────────────────────────────────────────────────────

# ── Running locally (no Docker) ──────────────────────────
# Your own MySQL server. src/config.py reads DATABASE_URL and nothing else,
# so this single value decides which database every component talks to.
DATABASE_URL=mysql+mysqlconnector://your_user:your_password@localhost:3306/datatrust

# Application settings
APP_ENV=development            # development | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# Data paths (relative to project root)
RAW_DATA_PATH=data/raw/online_retail.csv
PROCESSED_DATA_PATH=data/processed/
REPORTS_PATH=reports/

# Quality score thresholds
QUALITY_THRESHOLD_CRITICAL=50
QUALITY_THRESHOLD_POOR=75
QUALITY_THRESHOLD_WARNING=90

# ── Running the Docker stack ─────────────────────────────
# docker-compose.yml reads these four values, provisions the MySQL container
# from them, and builds each container's DATABASE_URL as:
#   mysql+mysqlconnector://MYSQL_USER:MYSQL_PASSWORD@mysql:3306/MYSQL_DATABASE
# The hostname is the compose service name `mysql`, so the DATABASE_URL above
# (localhost) is NOT used by containers - they never share your host database.
# Compose refuses to start if any of the three passwords/users is missing.
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=datatrust
MYSQL_USER=datatrust_user
MYSQL_PASSWORD=change_me_app

# Host port for the containerised MySQL. Defaults to 3307 rather than 3306
# so it cannot collide with a MySQL server already installed on your machine.
MYSQL_HOST_PORT=3307
